<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         TIPOGRAFIA TERMINAL
         Tudo em monospace, caixa alta e letter-spacing,
         igual ao terminal.css.
         ============================================================ -->

    <style name="TermText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/term_fg</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TermTitle" parent="TermText">
        <item name="android:textColor">@color/term_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:shadowColor">#668BE9FD</item>
        <item name="android:shadowRadius">10</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <style name="TermSubtitle" parent="TermText">
        <item name="android:textColor">@color/term_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="TermLabel" parent="TermText">
        <item name="android:textColor">@color/term_fg</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TermSection" parent="TermText">
        <item name="android:textColor">@color/term_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="TermMuted" parent="TermText">
        <item name="android:textColor">@color/term_muted</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TermValue" parent="TermText">
        <item name="android:textColor">@color/term_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TermStatus" parent="TermText">
        <item name="android:textColor">@color/term_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TermDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/term_border</item>
    </style>

    <!-- Cabeçalho de grupo (card), no espirito do painel do PC -->
    <style name="TermGroupTitle" parent="TermText">
        <item name="android:textColor">@color/term_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <!-- ============================================================
         CONTROLES ESTILO CAMERA (sobrepostos ao video)
         ============================================================ -->

    <!-- Botao redondo da coluna lateral direita. -->
    <style name="CamRound" parent="TermText">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/cam_round</item>
        <item name="android:textColor">@color/term_fg</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Botao de preset de zoom na fileira inferior. -->
    <style name="CamPill" parent="TermText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/cam_pill</item>
        <item name="android:textColor">@color/term_fg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">54dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>
