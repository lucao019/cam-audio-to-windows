<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B0F"
    android:padding="16dp">

    <!-- CABEÇALHO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUCAO LINK"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANDROID → WINDOWS"
                android:textColor="#8E8E9A"
                android:textSize="11sp"
                android:letterSpacing="0.12" />

        </LinearLayout>

        <TextView
            android:id="@+id/connectionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● OFFLINE"
            android:textColor="#8E8E9A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>


    <!-- PREVIEW DA CÂMERA -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#15151C">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:text="640 × 480  •  30 FPS  •  H.264"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="#99000000"
            android:padding="6dp" />

    </FrameLayout>


    <!-- STATUS -->

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PC DESCONECTADO"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />


    <!-- WEBCAM -->

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#15151C"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp">

    <!-- CABECALHO WEBCAM -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEBCAM"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H.264 | 640 x 480 | 30 FPS"
                android:textColor="#8E8E9A"
                android:textSize="11sp" />

        </LinearLayout>

        <Switch
            android:id="@+id/webcamSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:thumbTint="@color/switch_thumb_color"
            android:trackTint="@color/switch_track_color" />

    </LinearLayout>

    <!-- ZOOM -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ZOOM"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoomValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.0x"
            android:textColor="#39FF88"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/zoomSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="11"
        android:progressTint="#7C3AED"
        android:thumbTint="#39FF88" />

    <!-- LIMITES DO ZOOM -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/zoomMinText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1.0x"
            android:textColor="#70707A"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/zoomMaxText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10.0x"
            android:textColor="#70707A"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>

<!-- MICROFONE -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#15151C"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MICROFONE"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÁUDIO • EM DESENVOLVIMENTO"
                android:textColor="#8E8E9A"
                android:textSize="11sp" />

        </LinearLayout>

        <Switch
    android:id="@+id/microphoneSwitch"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:enabled="false"
    android:checked="false"
    android:thumbTint="@color/switch_thumb_color"
    android:trackTint="@color/switch_track_color" />

    </LinearLayout>


    <!-- CONECTAR -->

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CONECTAR AO PC"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:backgroundTint="#7C3AED" />

</LinearLayout>