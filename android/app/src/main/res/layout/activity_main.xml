<?xml version="1.0" encoding="utf-8"?>

<!--
  LUCAO LINK - celular
  Layout no estilo app de camera: video em tela cheia e os
  controles sobrepostos em cima do preview (igual a camera
  nativa do aparelho). O que aparece aqui espelha o painel do
  PC - mesma fileira de zoom, mesmos botoes.

  Os ids abaixo sao os que o MainActivity espera. Os widgets
  legados (statusText, connectButton, zooms de texto etc.) ficam
  escondidos, mas continuam ligados para nao quebrar o codigo.
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ============ PREVIEW (tela cheia, infinito ao fundo) ============
         Sem clip: o video preenche a tela toda por baixo dos
         controles (mode="fill"/crop do CameraX). -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:importantForAccessibility="no" />

    <!-- veu escuro no topo/base para o texto render melhor -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/cam_scrim_topo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="@drawable/cam_scrim_base" />

    <!-- grade de mira discreta sobre o video -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cam_grade"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- ============ TOPO SOBREPOSTO ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cam_hud"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <View
                    android:id="@+id/bolinha"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_red" />

                <TextView
                    android:id="@+id/connectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="● SEM STREAM"
                    android:textColor="@color/term_danger"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="host automatico"
                android:textColor="@color/term_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ CONTROLES LATERAIS (direita) ============ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnFlash"
            style="@style/CamRound"
            android:contentDescription="flash"
            android:text="flash" />

        <Button
            android:id="@+id/btnLente"
            style="@style/CamRound"
            android:contentDescription="trocar lente"
            android:text="lente" />

        <Button
            android:id="@+id/rotateButton"
            style="@style/CamRound"
            android:contentDescription="girar 90 graus"
            android:text="girar" />

        <Button
            android:id="@+id/btnAutoRot"
            style="@style/CamRound"
            android:contentDescription="rotacao automatica"
            android:text="auto" />

        <Button
            android:id="@+id/mirrorButton"
            style="@style/CamRound"
            android:contentDescription="espelhar"
            android:text="espelho" />
    </LinearLayout>

    <!-- ============ BASE SOBREPOSTA ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="18dp">

        <!-- fileira de presets de zoom (igual painel do PC) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/zoomPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- linha principal: conectar + webcam + microfone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connectButton"
                style="@style/CamPill"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="conectar"
                android:textColor="@color/term_fg" />

            <CheckBox
                android:id="@+id/webcamSwitch"
                style="@style/CamPill"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="webcam"
                android:textColor="@color/term_fg" />

            <CheckBox
                android:id="@+id/microphoneSwitch"
                style="@style/CamPill"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="mic"
                android:textColor="@color/term_fg" />
        </LinearLayout>

        <!-- valor do zoom em tempo real (pinça ou preset) -->
        <TextView
            android:id="@+id/zoomBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/cam_hud"
            android:fontFamily="monospace"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="1.0x"
            android:textColor="@color/term_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ============================================================
         WIDGETS LEGADOS (fora da tela, mantidos para o codigo)
         ============================================================ -->
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/pcHostInput"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/txtVideo"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/txtAudio"
            android:layout_width="1dp"
            android:layout_height="1dp" />
    </LinearLayout>

</FrameLayout>
